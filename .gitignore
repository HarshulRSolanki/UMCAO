# Environment variables & secrets (CRITICAL: Never commit secrets)
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
service-account*.json

# Backend SQLite Database & Local Data
*.db
*.sqlite
*.sqlite3
backend/umcao.db
*.db-journal
*.db-wal

# Python Cache & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
