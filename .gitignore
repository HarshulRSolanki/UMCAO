.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Node.js & React Frontend
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
frontend/build/
package-lock.json
frontend/package-lock.json
*.lock
yarn.lock
pnpm-lock.yaml
.npm
.eslintcache
.stylelintcache
*.tsbuildinfo

# IDE & Editor Configurations
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

