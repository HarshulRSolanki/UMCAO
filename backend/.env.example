# ==============================================================================
# UMCAO Backend Environment Configuration Template
# Copy this file to backend/.env and fill in your actual credentials.
# NEVER commit backend/.env containing real keys to Git.
# ==============================================================================

# Google Gemini AI API Key (Required for AI Explanations & Error Diagnosis)
# Obtain your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Optional; defaults to gemini-3.5-flash-lite)
# Options: gemini-3.5-flash-lite, gemini-3.5-flash, gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Database URL (Optional; defaults to local SQLite file umcao.db)
DATABASE_URL=sqlite:///umcao.db

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

